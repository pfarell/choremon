# ------------------------------------------------------------------
# Chorémon environment variables — copy to .env.local and fill in.
# Every key lives here; nothing is hardcoded in the source.
# ------------------------------------------------------------------

# Google Gemini — primary vision + chat model (scan / analyze routes)
GEMINI_API_KEY=your_gemini_api_key
# Optional extra Gemini keys (comma-separated) used for load spreading
GEMINI_API_KEYS=

# Public Gemini key for the client-side Multimodal Live WebSocket
NEXT_PUBLIC_GEMINI_API_KEY=your_public_gemini_key

# ElevenLabs — Rascal's voice (rascal-speak route)
ELEVENLABS_API_KEY=your_elevenlabs_key

# Fallback vision providers for trash detection
OPENROUTER_API_KEY=your_openrouter_key
FEATHERLESS_API_KEY=your_featherless_key

# Optional OpenAI vision path (vision route)
OPENAI_API_KEY=
